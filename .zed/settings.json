{
  "languages": {
    "Typst": {
      "tab_size": 2,
      "hard_tabs": false,
      "soft_wrap": "editor_width",
      "enable_language_server": true
    }
  },

  "lsp": {
    "tinymist": {
      "settings": {
        "rootPath": "src",
        "fontPaths": ["src/hsrtreport/src/assets/fonts"],
        "outputPath": "$root/../build/$name",
        "exportPdf": "onSave"
      }
    }
  },

  "file_scan_exclusions": ["build/"],

  "task_aliases": {
    "build": "make",
    "watch": "make watch",
    "clean": "make clean"
  }
}
