{
  "tinymist.rootPath": "src",
  "tinymist.fontPaths": ["src/hsrtreport/src/assets/fonts"],
  "tinymist.systemFonts": true,
  "tinymist.outputPath": "$root/../build/$name",
  "tinymist.exportPdf": "onSave",

  "files.associations": {
    "*.typ": "typst"
  },

  "[typst]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  },

  "cSpell.language": "de,en",
  "cSpell.enableFiletypes": ["typst"],

  "search.exclude": {
    "build/**": true
  }
}
